VITE_RADIO_API_URL=https://radio-api.cieslak.dev

# Ships the #meta tuning panel in a production build. Off by default: when unset
# the panel's code is tree-shaken out entirely. With it on, the panel still only
# appears when you load the page with ?tuner — normal visitors never see it.
# Always available in `pnpm dev`, regardless of this setting.
# VITE_ENABLE_TUNER=true

# Buffer channel IDs for scripts/post-video.sh — see scripts/README.md.
# Fetch with: buffer channels list --fields id,name,service --output json
BUFFER_ORGANIZATION_ID=
BUFFER_YOUTUBE_CHANNEL_ID=
BUFFER_TIKTOK_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=

# YouTube Live stream key for scripts/livestream.sh — see scripts/README.md.
# YouTube Studio → Create → Go live → Stream → "Stream key". Treat it like a password.
YOUTUBE_STREAM_KEY=

# Twitch / Kick, for `scripts/livestream.sh --platform twitch|kick`. No 24h wait on either.
# Twitch: Creator Dashboard → Settings → Stream → Primary Stream key.
TWITCH_STREAM_KEY=
# Kick: Dashboard → Settings → Stream URL & Key (the URL is per-account, rtmps://…/app/).
KICK_STREAM_URL=
KICK_STREAM_KEY=
